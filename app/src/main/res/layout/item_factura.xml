<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#DDDDDD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNumeroFactura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Factura #001"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tvCufe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CUFE:"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvNitVendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NIT vendedor:"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvNitComprador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NIT comprador:"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvFechaHoraVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha y hora:"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvValorSinImpuestos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valor sin impuestos:"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvIVA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valor añadido por el IVA:"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvValorConImpuestos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valor con impuestos:"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvMedioPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medio de pago:"
            android:layout_marginTop="6dp"/>

        <Button
            android:id="@+id/btnVerFactura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ver factura completa"/>

        <Button
            android:id="@+id/btnEliminarFactura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#CC0000"
            android:text="Eliminar factura"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
