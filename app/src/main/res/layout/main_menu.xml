<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="25dp"
            android:background="#171717">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARVEX"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <View
                android:layout_width="45dp"
                android:layout_height="3dp"
                android:background="#FFFFFF"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="17dp"/>

        </LinearLayout>

        <!-- Título de sección -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Panel de administración"
            android:textColor="#171717"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una opción para continuar."
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginBottom="18dp"/>

        <!-- Registrar factura -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            app:strokeColor="#E5E5E5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="＋"
                    android:textSize="30sp"
                    android:textColor="#FFFFFF"
                    android:background="#171717"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registrar factura"
                        android:textColor="#171717"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crear una nueva factura de venta"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarFactura"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#171717"
                    app:cornerRadius="10dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Registro de facturas -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            app:strokeColor="#E5E5E5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="≡"
                    android:textSize="30sp"
                    android:textColor="#FFFFFF"
                    android:background="#171717"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registro de facturas"
                        android:textColor="#171717"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consultar facturas anteriores"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistroFacturas"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#171717"
                    app:cornerRadius="10dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Guardar producto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            app:strokeColor="#E5E5E5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="▣"
                    android:textSize="25sp"
                    android:textColor="#FFFFFF"
                    android:background="#171717"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guardar producto"
                        android:textColor="#171717"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agregar productos al inventario"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#171717"
                    app:cornerRadius="10dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Consultar productos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            app:strokeColor="#E5E5E5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="⌕"
                    android:textSize="30sp"
                    android:textColor="#FFFFFF"
                    android:background="#171717"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consultar productos"
                        android:textColor="#171717"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buscar productos registrados"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConsultarProductos"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#171717"
                    app:cornerRadius="10dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pie de página -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ARVEX  •  Sistema de gestión"
            android:textColor="#999999"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>

</ScrollView>
