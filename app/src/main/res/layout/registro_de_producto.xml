<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar producto"
            android:textColor="#172554"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresa la información del nuevo producto."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del producto"
            android:textColor="#334155"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ej. Computador portátil"
            android:inputType="textCapSentences"
            android:backgroundTint="#64748B"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#334155"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etDescripcionProducto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Describe las características del producto"
            android:gravity="top"
            android:inputType="textCapSentences|textMultiLine"
            android:backgroundTint="#64748B"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Precio de venta (COP)"
            android:textColor="#334155"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etPrecioProducto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ej. 150000"
            android:inputType="numberDecimal"
            android:backgroundTint="#64748B"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Guardar producto"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#1D4ED8"/>

        <Button
            android:id="@+id/btnVolverMenu"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Volver al menú"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="#475569"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvEstadoProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>