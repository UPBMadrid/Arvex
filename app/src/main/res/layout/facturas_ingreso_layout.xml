<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Ingresar datos"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etNITV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="NIT del vendedor"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <EditText
        android:id="@+id/etNITC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="NIT del comprador"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/etNITV"/>
    <EditText
        android:id="@+id/etFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fecha y hora en la que se realizó la venta"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/etNITC"/>
    <EditText
        android:id="@+id/etvalorSI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor sin impuestos"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/etFecha"/>
    <EditText
        android:id="@+id/etMedioP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Medio de pago"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/etvalorSI"/>
    <EditText
        android:id="@+id/etCUFE"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Código Único de Factura Electrónica"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/etMedioP"/>
    <Button
        android:id="@+id/btnIntroducir"
        android:layout_width="128dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Introducir"
        android:backgroundTint="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etCUFE" />

    <Button
        android:id="@+id/btnMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver al menú"
        android:backgroundTint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvEstado2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/btnMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etCUFE" />
</androidx.constraintlayout.widget.ConstraintLayout>